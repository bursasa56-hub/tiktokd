BOT_TOKEN=123456:ABC-your-token-from-BotFather
ADMIN_IDS=123456789

# --- Большие файлы (до 2 ГБ) через локальный Bot API сервер ---
# Получите на https://my.telegram.org -> API development tools
API_ID=1234567
API_HASH=your_api_hash

# Адрес локального Bot API сервера. Оставьте пустым, чтобы использовать
# публичный api.telegram.org (лимит файла 50 МБ).
TELEGRAM_API_URL=

# Максимальный размер файла в МБ (по умолчанию: 2000 с локальным сервером, иначе 49)
TELEGRAM_MAX_MB=
